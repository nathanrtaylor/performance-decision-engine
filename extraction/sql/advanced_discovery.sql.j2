-- extraction/sql/advanced_discovery.sql.j2
--
-- Advanced Discovery Call Flow V1 behavior pass-rates per expert-week.
--
-- SPLIT FROM behavior_scores: Advanced Discovery is a distinct Verizon proactive-sell scorecard whose
-- behaviors ALL populate the `response_recommendation_advancedevidences_operator` status ('Is_Present' /
-- 'Is_Not_Present') on the AutoQA table. That lets us define an honest present-COUNT pass-rate here:
--   numerator   = # of the expert's calls that week where the behavior was `Is_Present`
--                 (collapsed to one 0/1 flag per (expert, meeting, behavior) then summed by week).
--   denominator = "calls taken" = COUNT(DISTINCT meeting_id) per (expert, week) for this scorecard --
--                 the distinct calls the scorecard ran for the expert that week (shared across behaviors).
--   calc        = numerator / denominator = share of this scorecard's calls where the behavior appeared.
--
-- The HEROES + sentiment scorecards do NOT populate the operator uniformly (present-count reads false
-- zeros there), so they stay on the score/opportunity ratio in behavior_scores.sql.j2. AD lives here on
-- its own so each scorecard family uses the model that is correct for it -- no UNION, no cross-source join.
-- Everything comes from l3_asurion_observe_autoqa_evaluations; epm is ONLY a roster semi-join filter.
-- Cohort (icp_client) is attached downstream in build_signals via the agents.csv merge.

WITH roster AS (
  -- distinct cohort-scoped experts over the window (semi-join filter; no row multiplication)
  SELECT DISTINCT a.expert_id AS agent_id
  FROM {{ source_schema }}.{{ epm_table }} a
  WHERE CAST(a."date" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
    AND LOWER(a.icp_client) IN (
      {% for c in icp_clients %}'{{ c | lower }}'{% if not loop.last %},{% endif %}{% endfor %}
    )
),

present_call AS (
  -- one row per (agent, week, behavior, meeting): was the behavior PRESENT on that call?
  -- MAX collapses duplicate evaluation rows for the same call-behavior to a single 0/1.
  SELECT
    b.partner_agent_id                       AS agent_id,
    CAST(date_add('day', 4, date_trunc('week', CAST(b."created_at" AS DATE))) AS DATE) AS week_ending,
    b.template_questions_phrase              AS behavior_raw,
    MAX(CASE WHEN LOWER(TRIM(b.{{ presence_col }})) = '{{ present_value | lower }}' THEN 1 ELSE 0 END) AS is_present
  FROM {{ source_schema }}.{{ observe_table }} b
  JOIN roster r ON r.agent_id = b.partner_agent_id
  WHERE CAST(b."created_at" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
    AND b.template_questions_name = '{{ ad_scorecard }}'
  GROUP BY 1, 2, 3, b.meeting_id
),

behavior_week AS (
  -- weekly numerator per (agent, week, canonical behavior). TRIM the AD names (source has trailing
  -- spaces) and namespace the two behaviors that collide with HEROES ('Confirm Resolution',
  -- 'Transition Statement') with an ' (Advanced Discovery)' suffix so they map to their own metrics.
  SELECT
    agent_id,
    week_ending,
    CASE TRIM(regexp_replace(behavior_raw, '\s*:\s*$', ''))
      WHEN 'Confirm Resolution'   THEN 'Confirm Resolution (Advanced Discovery)'
      WHEN 'Transition Statement' THEN 'Transition Statement (Advanced Discovery)'
      ELSE TRIM(regexp_replace(behavior_raw, '\s*:\s*$', ''))
    END AS behavior,
    SUM(is_present) AS numerator
  FROM present_call
  GROUP BY 1, 2, 3
),

calls_taken AS (
  -- synthesized denominator: distinct calls this scorecard ran for the expert that week.
  SELECT
    b.partner_agent_id                       AS agent_id,
    CAST(date_add('day', 4, date_trunc('week', CAST(b."created_at" AS DATE))) AS DATE) AS week_ending,
    COUNT(DISTINCT b.meeting_id)             AS denominator
  FROM {{ source_schema }}.{{ observe_table }} b
  JOIN roster r ON r.agent_id = b.partner_agent_id
  WHERE CAST(b."created_at" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
    AND b.template_questions_name = '{{ ad_scorecard }}'
  GROUP BY 1, 2
)

SELECT
  bw.agent_id                          AS agent_id,
  bw.week_ending                       AS week_ending,
  'all'                                AS call_type,
  '{{ ad_scorecard }}'                 AS scorecard_name,
  bw.behavior                          AS behavior,
  CAST(bw.numerator AS DOUBLE)         AS numerator,
  CAST(ct.denominator AS DOUBLE)       AS denominator,
  CASE
    WHEN ct.denominator IS NULL OR ct.denominator = 0 THEN NULL
    ELSE CAST(bw.numerator AS DOUBLE) / ct.denominator
  END                                  AS calc
FROM behavior_week bw
JOIN calls_taken ct
  ON ct.agent_id = bw.agent_id
 AND ct.week_ending = bw.week_ending
