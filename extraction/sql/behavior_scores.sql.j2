-- extraction/sql/behavior_scores.sql.j2
--
-- Behavior (AI/QA scorecard) pass-rates per expert-week.
--
-- Aggregated PURELY from the observe scores table, so numerator/denominator are TRUE
-- score/opportunity counts. expert_performance_metrics (epm) is used ONLY as a roster
-- filter via a DISTINCT semi-join -- it is NEVER joined row-for-row. epm is a *tall*
-- per-metric table (one row per expert/date/metric); the previous row-level join on
-- (expert_id, date) multiplied every behavior by that expert's metric-count for the day,
-- inflating numerator/denominator ~100-300x and re-weighting the weekly rate by
-- metric-count instead of opportunity. A DISTINCT semi-join filters without multiplying.
--
-- Cohort (icp_client) is NOT emitted here; it is attached downstream in build_signals by
-- merging agents.csv on (agent_id, week_ending) -- the single canonical roster/cohort
-- source. That merge already exists and already backfills icp_client for this source.

WITH roster AS (
  -- distinct cohort-scoped experts over the window (semi-join filter; no row multiplication)
  SELECT DISTINCT a.expert_id AS agent_id
  FROM {{ source_schema }}.{{ epm_table }} a
  WHERE CAST(a."date" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
    AND LOWER(a.icp_client) IN (
      {% for c in icp_clients %}'{{ c | lower }}'{% if not loop.last %},{% endif %}{% endfor %}
    )
)

SELECT
  b.expert_id AS agent_id,
  {% if use_pay_calendar | default(false) %}
  CAST(d.week_stop_date AS DATE) AS week_ending,
  {% else %}
  CAST(date_add('day', 4, date_trunc('week', CAST(b."date" AS DATE))) AS DATE) AS week_ending,
  {% endif %}
  'all' AS call_type,
  b.template_questions_name AS scorecard_name,
  b.behavior_name AS behavior,
  SUM(COALESCE(CAST(b.score AS DOUBLE), 0.0))       AS numerator,
  SUM(COALESCE(CAST(b.opportunity AS DOUBLE), 0.0)) AS denominator,
  CASE
    WHEN SUM(COALESCE(CAST(b.opportunity AS DOUBLE), 0.0)) = 0 THEN NULL
    ELSE SUM(COALESCE(CAST(b.score AS DOUBLE), 0.0)) / SUM(COALESCE(CAST(b.opportunity AS DOUBLE), 0.0))
  END AS calc
FROM {{ source_schema }}.{{ observe_table }} b

{% if use_pay_calendar | default(false) %}
LEFT JOIN {{ pay_calendar_schema }}.{{ pay_calendar_table }} d
  ON CAST(b."date" AS DATE) = CAST(d.event_date AS DATE)
{% endif %}

JOIN roster r
  ON r.agent_id = b.expert_id

WHERE CAST(b."date" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
  AND b.template_questions_name IN (
    {% for sc in observe_scorecards %}'{{ sc }}'{% if not loop.last %},{% endif %}{% endfor %}
  )
GROUP BY 1, 2, 3, 4, 5
