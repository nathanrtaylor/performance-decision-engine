-- extraction/sql/behavior_scores.sql.j2
--
-- Behavior (AI/QA scorecard) pass-rates per expert-week.
--
-- Aggregated PURELY from the observe scores table, so numerator/denominator are TRUE
-- score/opportunity counts. expert_performance_metrics (epm) is used ONLY as a roster
-- filter via a DISTINCT semi-join -- it is NEVER joined row-for-row. epm is a *tall*
-- per-metric table (one row per expert/date/metric); the previous row-level join on
-- (expert_id, date) multiplied every behavior by that expert's metric-count for the day,
-- inflating numerator/denominator ~100-300x and re-weighting the weekly rate by
-- metric-count instead of opportunity. A DISTINCT semi-join filters without multiplying.
--
-- SCORE COLUMNS: use response_obtainedscore / template_questions_score (the per-question response
-- score and its max). The earlier obtainedscore / totalscore columns were scorecard-level totals,
-- which both inflated denominators ~15-40x AND returned wrong pass-rates (recap-resolution read ~0.73
-- vs the true ~0.20). Switching to these per-question columns restored pass-rates to the historical
-- scale and brought denominators back to the pre-migration range.
--
-- DEDUP: the AutoQA evaluations table also carries duplicate rows per call -- the same
-- (agent, meeting, behavior) evaluation can appear more than once. The `dedup` CTE collapses to ONE
-- row per (agent, event-date, scorecard, behavior, meeting_id) BEFORE the weekly SUM so each call
-- contributes once. meeting_id is a dedup key only; it is NOT emitted. (MAX assumes the duplicate
-- rows for a given meeting/behavior are identical; if evaluations can genuinely differ per meeting,
-- switch to a row_number() "pick one" on a deterministic ordering column.) NOTE: with the correct
-- score columns the residual duplication is modest -- run the with/without-dedup diagnostic
-- (extraction/sql/diagnostics/) to confirm it still earns its keep before removing it.
--
-- Cohort (icp_client) is NOT emitted here; it is attached downstream in build_signals by
-- merging agents.csv on (agent_id, week_ending) -- the single canonical roster/cohort
-- source. That merge already exists and already backfills icp_client for this source.

WITH roster AS (
  -- distinct cohort-scoped experts over the window (semi-join filter; no row multiplication)
  SELECT DISTINCT a.expert_id AS agent_id
  FROM {{ source_schema }}.{{ epm_table }} a
  WHERE CAST(a."date" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
    AND LOWER(a.icp_client) IN (
      {% for c in icp_clients %}'{{ c | lower }}'{% if not loop.last %},{% endif %}{% endfor %}
    )
),

dedup AS (
  -- one row per (agent, event-date, scorecard, behavior, meeting_id): collapse duplicate
  -- evaluation rows for the same call so each call's opportunity is counted once downstream.
  SELECT
    b.partner_agent_id                       AS agent_id,
    CAST(b."created_at" AS DATE)             AS evt_date,
    b.template_questions_name                AS scorecard_name,
    b.template_questions_phrase              AS behavior_raw,
    MAX(CAST(b.response_obtainedscore AS DOUBLE))     AS response_obtainedscore,
    MAX(CAST(b.template_questions_score AS DOUBLE))        AS template_questions_score
  FROM {{ source_schema }}.{{ observe_table }} b
  JOIN roster r
    ON r.agent_id = b.partner_agent_id
  WHERE CAST(b."created_at" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
    AND b.template_questions_name IN (
      {% for sc in observe_scorecards %}'{{ sc }}'{% if not loop.last %},{% endif %}{% endfor %}
    )
  GROUP BY
    b.partner_agent_id,
    CAST(b."created_at" AS DATE),
    b.template_questions_name,
    b.template_questions_phrase,
    b.meeting_id          -- dedup key only; intentionally not selected/emitted
)

SELECT
  d.agent_id AS agent_id,
  {% if use_pay_calendar | default(false) %}
  CAST(pc.week_stop_date AS DATE) AS week_ending,
  {% else %}
  CAST(date_add('day', 4, date_trunc('week', d.evt_date)) AS DATE) AS week_ending,
  {% endif %}
  'all' AS call_type,
  d.scorecard_name AS scorecard_name,
  -- The AutoQA source prefixes HEROES behavior names per scorecard ('_Foo' on the AT&T-family
  -- Auto Scorecard, 'N~Foo' on the Verizon QA scorecard) and varies '&'/'and'. Normalize the two
  -- HEROES scorecards to the canonical clean name so each cohort feeds ONE metric_catalog behavior
  -- (matching is by behavior string, scorecard-agnostic).
  --
  -- Advanced Discovery is a distinct Verizon proactive-sell flow: TRIM its names (source has trailing
  -- spaces on 'Greeting '/'Transition Statement '), and namespace the two behaviors whose names collide
  -- with HEROES ('Confirm Resolution', 'Transition Statement') with an ' (Advanced Discovery)' suffix so
  -- the proactive-sell context maps to its own metrics instead of blending into the reactive HEROES ones.
  CASE
    WHEN d.scorecard_name IN ('HEROES Auto Scorecard', 'HEROES Auto QA Reporting - VZW')
    THEN replace(TRIM(regexp_replace(regexp_replace(d.behavior_raw, '^\s*(\d+~|_)', ''), '\s*:\s*$', '')), ' & ', ' and ')
    WHEN d.scorecard_name = 'Advanced Discovery Call Flow V1'
    THEN CASE TRIM(regexp_replace(d.behavior_raw, '\s*:\s*$', ''))
           WHEN 'Confirm Resolution'   THEN 'Confirm Resolution (Advanced Discovery)'
           WHEN 'Transition Statement' THEN 'Transition Statement (Advanced Discovery)'
           ELSE TRIM(regexp_replace(d.behavior_raw, '\s*:\s*$', ''))
         END
    ELSE d.behavior_raw
  END AS behavior,
  SUM(COALESCE(d.response_obtainedscore, 0.0)) AS numerator,
  SUM(COALESCE(d.template_questions_score, 0.0))    AS denominator,
  CASE
    WHEN SUM(COALESCE(d.template_questions_score, 0.0)) = 0 THEN NULL
    ELSE SUM(COALESCE(d.response_obtainedscore, 0.0)) / SUM(COALESCE(d.template_questions_score, 0.0))
  END AS calc
FROM dedup d

{% if use_pay_calendar | default(false) %}
LEFT JOIN {{ pay_calendar_schema }}.{{ pay_calendar_table }} pc
  ON d.evt_date = CAST(pc.event_date AS DATE)
{% endif %}

GROUP BY 1, 2, 3, 4, 5
