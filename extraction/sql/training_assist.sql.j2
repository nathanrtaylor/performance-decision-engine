-- extraction/sql/training_assist.sql.j2
--
-- TrAIning Assist (AI-assisted training simulator) behavior pass-rates per expert-week.
--
-- Tall-skinny output: one row per (agent_id, week_ending, call_type, challenge_id, behavior).
-- Each AI-assisted training session emits a list of evaluated behaviors, each with a
-- behaviorPresent flag (0/1). We aggregate to present-rates:
--   numerator   = SUM(behaviorPresent)   (times the behavior was demonstrated)
--   denominator = SUM(opportunity)       (times the behavior was evaluated; 1.0 per behavior/session)
--   calc        = numerator / denominator
--   attempts    = COUNT(DISTINCT session_id)
--
-- This is the RAW behavior grain (profile = challenge_id is still present). The
-- behavior->skill mapping and per-profile relevance filtering are applied downstream by
-- src/cde/ingestion/training_assist_skills.py (which reads configs/training/training_profiles.yaml)
-- to produce the skill-level output that feeds signals.
--
-- Dates are parameterized like every other extract: the window is applied to the
-- SESSION date (when the training happened -- the analog of behavior_scores' event date),
-- so week_ending always falls inside the extract window. {{ start_date }} / {{ end_date }} /
-- {{ source_schema }} come from extract_run.yaml globals via compile_sql.build_context.
--
-- Cohort (icp_client) is NOT emitted here; it is attached downstream in build_signals by
-- merging agents.csv on (agent_id, week_ending) -- the single canonical roster/cohort source.

WITH base AS (
    SELECT DISTINCT
        element_at(
            edp_raw_data_map,
            'dynamodb_Keys_SessionID_S'
        ) AS session_id,

        CAST(
            element_at(
                edp_raw_data_map,
                'dynamodb_NewImage_EmployeeId_S'
            ) AS BIGINT
        ) AS agent_id,

        CAST(
            SUBSTRING(
                element_at(
                    edp_raw_data_map,
                    'dynamodb_NewImage_SessionStartTime_S'
                ),
                1,
                10
            ) AS DATE
        ) AS session_date,

        element_at(
            edp_raw_data_map,
            'dynamodb_NewImage_ChallengeId_S'
        ) AS challenge_id,

        json_extract(
            edp_raw_data,
            '$.dynamodb.NewImage.EvaluationDetails.M.Body.L'
        ) AS evaluation_details

    FROM {{ source_schema }}.{{ training_table }}

    WHERE LOWER(
        element_at(
            edp_raw_data_map,
            'dynamodb_NewImage_EmployeeId_S'
        )
    ) NOT LIKE '%test%'

      AND element_at(
          edp_raw_data_map,
          'dynamodb_NewImage_EvaluationDetails_M_Overview_S'
      ) != ''

      -- Standard extract window, applied to the session start date so weeks align with a
      -- normal extract. (edp_updated_date could be added as a partition-pruning guard later.)
      AND CAST(
            SUBSTRING(
                element_at(
                    edp_raw_data_map,
                    'dynamodb_NewImage_SessionStartTime_S'
                ),
                1,
                10
            ) AS DATE
          ) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
),

behavior_scores AS (
    SELECT
        b.session_id,
        b.agent_id,
        b.session_date,
        b.challenge_id,

        LOWER(
            TRIM(
                json_extract_scalar(
                    behavior_item,
                    '$.M.behavior.S'
                )
            )
        ) AS behavior,

        COALESCE(
            TRY_CAST(
                json_extract_scalar(
                    behavior_item,
                    '$.M.behaviorPresent.N'
                ) AS DOUBLE
            ),
            0.0
        ) AS score,

        1.0 AS opportunity

    FROM base b

    CROSS JOIN UNNEST(
        COALESCE(
            TRY(
                CAST(b.evaluation_details AS ARRAY(JSON))
            ),
            CAST(ARRAY[] AS ARRAY(JSON))
        )
    ) AS u(behavior_item)
)

SELECT
    agent_id,

    CAST(
        date_add(
            'day',
            4,
            date_trunc('week', session_date)
        ) AS DATE
    ) AS week_ending,

    'all' AS call_type,

    challenge_id AS scorecard_name,

    behavior,

    COUNT(DISTINCT session_id) AS attempts,

    SUM(score) AS numerator,

    SUM(opportunity) AS denominator,

    CASE
        WHEN SUM(opportunity) = 0 THEN NULL
        ELSE SUM(score) / SUM(opportunity)
    END AS calc

FROM behavior_scores

WHERE behavior IS NOT NULL
  AND behavior != ''

GROUP BY
    1,
    2,
    3,
    4,
    5
