-- extraction/sql/agents.sql.j2
WITH base AS (
  SELECT
    CAST(date_add('day', 4, date_trunc('week', CAST(a."date" AS DATE))) AS DATE) AS week_ending,
    a.expert_id AS agent_id,
    a.expert AS agent_name,
    a.site AS mascot,
    LOWER(a.icp_client) AS icp_client,
    a.tenure_group,
    a.coach,
    a.supervisor_id AS coach_id,
    CAST(a."date" AS DATE) AS as_of_date
  FROM {{ source_schema }}.{{ source_table }} a
  WHERE CAST(a."date" AS DATE) BETWEEN DATE '{{ start_date }}' AND DATE '{{ end_date }}'
    AND LOWER(a.icp_client) IN (
      {% for c in icp_clients %}'{{ c | lower }}'{% if not loop.last %},{% endif %}{% endfor %}
    )
),

dedup AS (
  -- pick the latest observed attributes within the week per agent/client
  SELECT
    week_ending,
    agent_id,
    agent_name,
    icp_client,
    max_by(mascot, as_of_date) AS mascot,
    max_by(tenure_group, as_of_date) AS tenure_group,
    max_by(coach, as_of_date) AS coach,
    max_by(coach_id, as_of_date) AS coach_id
  FROM base
  GROUP BY 1,2,3,4
)

SELECT
  week_ending,
  agent_id,
  agent_name,
  mascot,
  icp_client,
  tenure_group,
  coach,
  coach_id
FROM dedup